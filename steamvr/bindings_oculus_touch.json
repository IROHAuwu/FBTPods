{
  "action_manifest_version": 0,
  "controller_type": "oculus_touch",
  "description": "Left Y/B double = quick reset, long = full reset; X/A (left) or B (right) long = touch reset",
  "name": "FBT Pods default (oculus_touch)",
  "bindings": {
    "/actions/airpodsvr": {
      "sources": [
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "double": {
              "output": "/actions/airpodsvr/in/quick_reset"
            },
            "long": {
              "output": "/actions/airpodsvr/in/full_reset"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "long": {
              "output": "/actions/airpodsvr/in/touch_reset"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "long": {
              "output": "/actions/airpodsvr/in/touch_reset"
            }
          }
        }
      ],
      "haptics": [
        {
          "output": "/actions/airpodsvr/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/airpodsvr/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  }
}
